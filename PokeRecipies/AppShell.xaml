<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PokeRecipies.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PokeRecipies"
    xmlns:routes="clr-namespace:PokeRecipies.Routes"
    Title="PokeRecipies"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Icon="dotnet_bot.png"
            Route="MainPage" />
        <ShellContent
            Title="Lista de recetas"
            ContentTemplate="{DataTemplate routes:RecipiesListPage}"
            Icon="dotnet_bot.png"
            Route="RecipiesListPage" />
        <ShellContent
            Title="Lista de recetas"
            ContentTemplate="{DataTemplate routes:RecipiePage}"
            Icon="dotnet_bot.png"
            Route="RecipiePage" />
    </TabBar>

</Shell>
