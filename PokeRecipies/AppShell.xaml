<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PokeRecipies.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ingredients="clr-namespace:PokeRecipies.Routes.Ingredients"
    xmlns:local="clr-namespace:PokeRecipies"
    xmlns:menu="clr-namespace:PokeRecipies.Routes.Menu"
    xmlns:recipes="clr-namespace:PokeRecipies.Routes.Recipes"
    Title="PokeRecipies"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Recetas" Icon="ic_checklist_black.png">
            <ShellContent
                Title="Curry"
                ContentTemplate="{DataTemplate recipes:RecipeListPage}"
                Route="RecipiesListPage" />

            <ShellContent
                Title="Ensaladas"
                ContentTemplate="{DataTemplate recipes:SaladsListPage}"
                Route="SaladsListViewModel" />

        </Tab>
        <ShellContent
            Title="Ingredientes"
            ContentTemplate="{DataTemplate ingredients:IngredientListPage}"
            Icon="ic_egg_black.png"
            Route="RecipiePage" />
        <ShellContent
            Title="Mas"
            ContentTemplate="{DataTemplate menu:MenuPage}"
            Icon="ic_dashboard_black.png"
            Route="MenuPage" />
    </TabBar>

</Shell>
