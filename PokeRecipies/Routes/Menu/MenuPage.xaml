<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PokeRecipies.Routes.Menu.MenuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PokeRecipies.Routes.Menu"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="page"
    Title="Menú"
    x:DataType="{x:Type local:MenuPageViewModel}">


    <Grid
        Padding="5"
        ColumnSpacing="5"
        RowDefinitions="*,auto"
        RowSpacing="5">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>

                <Button Command="{Binding GenerateDatastoreDataCommand}" Text="Generar Datos DataStore" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsGeneratingData}"
            IsVisible="{Binding IsGeneratingData}" />
    </Grid>

</ContentPage>