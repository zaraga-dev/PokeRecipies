<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PokeRecipies.Routes.Recipes.RecipePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PokeRecipies.Routes.Recipes"
    Title="{Binding RecipeName}"
    x:DataType="local:RecipePageViewModel"
    Shell.TabBarIsVisible="False">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding LoadInitialDataCommand}"
            Order="Secondary"
            Text="Recargar Información" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Frame
            BackgroundColor="Transparent"
            BorderColor="Transparent"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center">
            <VerticalStackLayout>
                <Label
                    FontSize="Large"
                    HorizontalOptions="Center"
                    Text="{Binding StatusMessage}"
                    VerticalOptions="Center" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" VerticalOptions="Center" />
            </VerticalStackLayout>
        </Frame>

        <ScrollView IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Spacing="20">
                <Frame BackgroundColor="{StaticResource Secondary}" CornerRadius="0">
                    <Image
                        HeightRequest="200"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="200">
                        <Image.Source>
                            <!--  Caché de 10 dias  -->
                            <UriImageSource
                                CacheValidity="10:00:00:00"
                                CachingEnabled="True"
                                Uri="{Binding RecipeImage}" />
                        </Image.Source>
                    </Image>
                </Frame>

                <Label
                    Margin="10,0"
                    FontSize="Medium"
                    Text="{Binding RecipeDescription}" />

                <BoxView />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>