<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PokeRecipies.Routes.Recipes.RecipePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PokeRecipies.Routes.Recipes"
    Title="{Binding RecipeName}"
    x:DataType="local:RecipePageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Style="{StaticResource Headline}" Text="Nombre:" />
            <Entry Placeholder="Nombre" Text="{Binding RecipeName}" />
            <Label Style="{StaticResource Headline}" Text="Descripción:" />
            <Entry Placeholder="Descripción" Text="{Binding RecipeDescription}" />

            <Image
                HeightRequest="100"
                HorizontalOptions="Center"
                Source="{Binding RecipeImage}"
                WidthRequest="100" />

            <Label
                FontSize="18"
                HorizontalOptions="Center"
                IsVisible="{Binding IsBusy}"
                Text="{Binding StatusMessage}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>